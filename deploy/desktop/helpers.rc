#
# The preferred application per category — the file every "open the default
# X" resolves through (exo-open, the CPU graph's click, context menus). Each
# value names a helper in /usr/share/xfce4/helpers/; editing this file IS the
# supported way to change a default, per room, and it persists in the room's
# home like the rest of the configuration.
TerminalEmulator=lxterminal
WebBrowser=chromium
FileManager=thunar
MailReader=thunderbird
