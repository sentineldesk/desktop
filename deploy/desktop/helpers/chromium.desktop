[Desktop Entry]
Version=1.0
Type=X-XFCE-Helper
Icon=chromium
Name=Chromium
X-XFCE-Category=WebBrowser
X-XFCE-Commands=/usr/bin/chromium
X-XFCE-CommandsWithParameter=/usr/bin/chromium %s
