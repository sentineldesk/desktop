#
# An exo helper: what "the preferred TerminalEmulator" resolves to. Debian
# ships /usr/share/xfce4/helpers empty, so before these files existed, any
# plugin that asked for a category — the CPU graph's click, exo-open, a
# "open terminal here" — got "Failed to launch preferred application" and
# nothing else. The per-user choice lives in ~/.config/xfce4/helpers.rc
# (shipped through the skeleton); these files are the candidates it can name.
[Desktop Entry]
Version=1.0
Type=X-XFCE-Helper
Icon=lxterminal
Name=LXTerminal
X-XFCE-Category=TerminalEmulator
X-XFCE-Commands=/usr/bin/lxterminal
X-XFCE-CommandsWithParameter=/usr/bin/lxterminal -e %s
