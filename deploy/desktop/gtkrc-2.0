# GTK2: lxpanel and other GTK2 applications read this; without it they lose
# their themed icons.
gtk-theme-name="Adwaita"
gtk-icon-theme-name="Papirus"
gtk-font-name="Roboto 10"
gtk-cursor-theme-name="Adwaita"
gtk-cursor-theme-size=24
gtk-menu-images=1
gtk-button-images=1
gtk-xft-antialias=1
gtk-xft-hinting=1
gtk-xft-hintstyle="hintslight"
gtk-xft-rgba="rgb"
