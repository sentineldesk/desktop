#!/usr/bin/pulseaudio -nF
# A virtual sink: applications play into it and GStreamer captures
# sentineldesk.monitor.
load-module module-native-protocol-unix
load-module module-null-sink sink_name=sentineldesk sink_properties=device.description=VirtualDesktop
set-default-sink sentineldesk
