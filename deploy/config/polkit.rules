// polkit — this desktop has no graphical authentication agent.
//
// Without this rule any application asking for permissions through polkit
// (gparted, synaptic, mounting a disk, a file manager in administrator mode)
// waits for a dialog nobody can answer, and fails with an opaque error.
// Since the `sentineldesk` user already has passwordless sudo, denying it polkit
// buys no security: it only breaks the graphical applications.
polkit.addRule(function(action, subject) {
    if (subject.isInGroup("sudo") || subject.user == "sentineldesk") {
        return polkit.Result.YES;
    }
});
