# ---------------------------------------------------------------------------
# Go
# ---------------------------------------------------------------------------
*.o
*.a
*.so
*.dylib

# Test / profiling output
*.test
*.out
*.prof
*.pprof
coverage.txt
coverage.html

# Build caches and outputs
/vendor/
/bin/
/dist/
/build/
go.work
go.work.sum

# The binary `go build` drops when run in this directory or next to the package
# (the package name doubles as the default binary name).
/sentineldesk
cmd/sentineldesk/sentineldesk

# ---------------------------------------------------------------------------
# Binaries (generic)
# ---------------------------------------------------------------------------
*.exe
*.exe~
*.dll
*.bin
*.elf
*.app

# ---------------------------------------------------------------------------
# macOS
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
Icon?

# ---------------------------------------------------------------------------
# Windows / Linux desktop cruft
# ---------------------------------------------------------------------------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*~
.directory
.Trash-*
.nfs*

# ---------------------------------------------------------------------------
# Editors / IDEs
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# ---------------------------------------------------------------------------
# Secrets, certificates and local config
# ---------------------------------------------------------------------------
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# The web client (app/): Node deps and build state. The client is BUILT into
# internal/webui/assets by vite (see below); nothing under app/ that is
# generated belongs in git.
# ---------------------------------------------------------------------------
/app/node_modules/
/app/dist/
/app/tsconfig.tsbuildinfo
.vite/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------------------------------------------------------------------------
# Python (tools/)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# ---------------------------------------------------------------------------
# Runtime / logs / temp
# ---------------------------------------------------------------------------
*.log
logs/
tmp/
.tmp/
*.pid
*.sock

# Recordings and captures produced by the desktop at runtime
recordings/
*.mp4
*.webm
*.mkv

# ---------------------------------------------------------------------------
# The web client is BUILT into this directory by app/ (vite); go:embed carries
# it into the binary. The sources live in app/src. Only the keep-file is
# tracked, so a bare `go build` still embeds a directory that exists.
# ---------------------------------------------------------------------------
/internal/webui/assets/*
!/internal/webui/assets/.gitkeep

# Local, machine-specific assistant guidance — not part of the product.
CLAUDE.md
